# SAFE DEFAULT: leave credentials empty. No production values belong here.
# No-secrets/no-provider/no-database demo:
# node scripts/dev/citizen-findings-qa-server.mjs --build
# The helper blanks credentials and supplies a LOCAL-ONLY signing value.
# Never deploy that fictional key or copy a teammate's .env.local.

# Real integrations ONLY in an owner-designated isolated project after approval.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privileged server-only existing operations; never expose to the browser or CI.
SUPABASE_SERVICE_ROLE_KEY=

# Authorized live AI/OCR/embeddings incur costs. Empty keys fail honestly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional dedicated server-only secret, minimum 32 characters, generated privately.
# Existing service key is the application's fallback; QA overrides both in memory.
DEMO_SESSION_SECRET=
