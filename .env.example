# Supabase — required. Real auth, database, and RLS; see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required for live/demo AI and image/scanned document OCR)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional dedicated server-only demo signing secret, at least 32 characters.
# If absent, the existing SUPABASE_SERVICE_ROLE_KEY signs isolated demo sessions.
DEMO_SESSION_SECRET=
